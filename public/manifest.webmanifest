{
  "name": "APBites — Smart Campus Dining",
  "short_name": "APBites",
  "description": "Discover campus food, check live stall workload, order ahead and collect with a pickup code.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FFFFFF",
  "theme_color": "#FFDA03",
  "lang": "en-MY",
